APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
SEND_REAL_EMERGENCY_ALERT=false
DOCUMENT_ENCRYPTION_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=simulator
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4174","http://127.0.0.1:4174","http://localhost:4175","http://127.0.0.1:4175","http://localhost:4176","http://127.0.0.1:4176"]
TESSERACT_CMD=

# Synthetic research: stable Fernet key is required for opt-in durable memory.
# Generate locally; never commit the real key. Without it, state is process-ephemeral.
RESEARCH_STATE_KEY=
RESEARCH_LLM_ENABLED=0
RESEARCH_INTENT_MODEL=openai/gpt-oss-20b
PUBLIC_UPLOAD_TTL_SECONDS=86400
# Optional administrator API; leave empty to disable. CLI generation needs no token.
SYNTHETIC_ADMIN_TOKEN=

# Guided verification: console is local-only; official sandbox needs exact allowlist.
OTP_DELIVERY_MODE=whatsmcp
OTP_ALLOWLIST=[]
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_AUTH_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

WHATSAPP_UTILITY_TEMPLATE=
PUBLIC_QUOTE_ORIGIN=

# Optional broker notification target: must also be allow-listed.
BROKER_NOTIFICATION_DESTINATION=
BROKER_NOTIFICATION_CHANNEL=email

# First-party aggregate counts; also requires frontend flag and visitor analytics consent.
JOURNEY_FUNNEL_ENABLED=false

# Normal service uses WhatsMCP; missing credentials disable verification. Never use VITE_* for keys.
WHATSMCP_API_KEY=
WHATSMCP_ACCOUNT_ID=
# Personal free-plan sends text; official Business accounts can reuse the optional
# WHATSAPP_AUTH_TEMPLATE / WHATSAPP_UTILITY_TEMPLATE fields above.
# OTP_ALLOWLIST and PUBLIC_QUOTE_ORIGIN are required for approved real link delivery.

# Twilio is parked while the prototype uses demo WhatsApp login.
# After upgrade/approval, uncomment and fill these settings (never VITE-prefixed).
# OTP_DELIVERY_MODE=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_WHATSAPP_FROM=
# TWILIO_OTP_PROVIDER=twilio_verify
# Custom OTP fallback: copy the predefined Verification Codes ContentSid from YOUR Console.
# TWILIO_OTP_CONTENT_SID=
# Registered production sender only, approved template variable 1 = full private URL.
# TWILIO_MAGIC_LINK_CONTENT_SID=
# Exact externally reachable HTTPS origin used for signature validation, no path.
# TWILIO_WEBHOOK_ORIGIN=
# TWILIO_SANDBOX=true
# Only legacy Sandbox accounts permitting free-form replies; signed inbound window required.
# New template-only trials must leave this false.
# TWILIO_LEGACY_SESSION_MESSAGES=false
MAGIC_LINK_EXPIRY_MINUTES=10
# Isolated development/test only: OTP_DELIVERY_MODE=mock AND this explicit opt-in.
WHATSAPP_MOCK_AUTH=false
